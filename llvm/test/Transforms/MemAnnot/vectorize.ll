; SLP vectorizes through the claim (the pair load uses the claim of %a);
; !mem.last_use on one of the scalar loads is dropped (fail-safe).
define void @slp(ptr %a, ptr %b) {
; LV-LABEL: define void @slp(
; LV-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
; LV-NEXT:    [[A_C:%.*]] = call ptr @llvm.mem.claim.p0(ptr [[A]], i64 8, i64 0)
; LV-NEXT:    [[A1:%.*]] = getelementptr inbounds i32, ptr [[A_C]], i64 1
; LV-NEXT:    [[B1:%.*]] = getelementptr inbounds i32, ptr [[B]], i64 1
; LV-NEXT:    [[X0:%.*]] = load i32, ptr [[A_C]], align 4
; LV-NEXT:    [[X1:%.*]] = load i32, ptr [[A1]], align 4, !mem.last_use [[META6:![0-9]+]]
; LV-NEXT:    [[Y0:%.*]] = add i32 [[X0]], 7
; LV-NEXT:    [[Y1:%.*]] = add i32 [[X1]], 7
; LV-NEXT:    store i32 [[Y0]], ptr [[B]], align 4
; LV-NEXT:    store i32 [[Y1]], ptr [[B1]], align 4
; LV-NEXT:    ret void
;
; SLP-LABEL: define void @slp(
; SLP-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
; SLP-NEXT:    [[A_C:%.*]] = call ptr @llvm.mem.claim.p0(ptr [[A]], i64 8, i64 0)
; SLP-NEXT:    [[TMP1:%.*]] = load <2 x i32>, ptr [[A_C]], align 4
; SLP-NEXT:    [[TMP2:%.*]] = add <2 x i32> [[TMP1]], splat (i32 7)
; SLP-NEXT:    store <2 x i32> [[TMP2]], ptr [[B]], align 4
; SLP-NEXT:    ret void
;
  %a.c = call ptr @llvm.mem.claim.p0(ptr %a, i64 8, i64 0)
  %a1 = getelementptr inbounds i32, ptr %a.c, i64 1
  %b1 = getelementptr inbounds i32, ptr %b, i64 1
  %x0 = load i32, ptr %a.c
  %x1 = load i32, ptr %a1, !mem.last_use !4
  %y0 = add i32 %x0, 7
  %y1 = add i32 %x1, 7
  store i32 %y0, ptr %b
  store i32 %y1, ptr %b1
  ret void
}

