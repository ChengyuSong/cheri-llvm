; LV-NEXT:    [[TMP19:%.*]] = call ptr @llvm.mem.claim.p0(ptr [[TMP15]], i64 4, i64 0)
; LV-NEXT:    store i32 1, ptr [[TMP16]], align 4, !llvm.access.group [[ACC_GRP10]]
; LV-NEXT:    store i32 1, ptr [[TMP17]], align 4, !llvm.access.group [[ACC_GRP10]]
; LV-NEXT:    store i32 1, ptr [[TMP18]], align 4, !llvm.access.group [[ACC_GRP10]]
