; LV-NEXT:    [[IDENT_CHECK:%.*]] = icmp ne i1 [[G]], true
; LV-NEXT:    br i1 [[IDENT_CHECK]], label %[[SCALAR_PH:.*]], label %[[VECTOR_PH:.*]]
; LV:       [[VECTOR_PH]]:
; LV-NEXT:    br label %[[VECTOR_BODY:.*]]
; LV:       [[VECTOR_BODY]]:
; LV-NEXT:    [[INDEX:%.*]] = phi i64 [ 0, %[[VECTOR_PH]] ], [ [[INDEX_NEXT:%.*]], %[[VECTOR_BODY]] ]
; LV-NEXT:    [[TMP0:%.*]] = getelementptr inbounds i16, ptr [[DST]], i64 [[INDEX]]
; LV-NEXT:    [[TMP1:%.*]] = call ptr @llvm.mem.claim.p0(ptr [[TMP0]], i64 2, i64 0)
; LV-NEXT:    [[TMP2:%.*]] = getelementptr i16, ptr [[TMP1]], i64 4
; LV-NEXT:    store <4 x i16> splat (i16 1), ptr [[TMP1]], align 2
; LV-NEXT:    store <4 x i16> splat (i16 1), ptr [[TMP2]], align 2
; LV-NEXT:    [[INDEX_NEXT]] = add nuw i64 [[INDEX]], 8
; LV-NEXT:    [[TMP3:%.*]] = icmp eq i64 [[INDEX_NEXT]], 16
; LV-NEXT:    br i1 [[TMP3]], label %[[MIDDLE_BLOCK:.*]], label %[[VECTOR_BODY]], !llvm.loop [[LOOP14:![0-9]+]]
; LV:       [[MIDDLE_BLOCK]]:
; LV-NEXT:    br label %[[EXIT:.*]]
; LV:       [[SCALAR_PH]]:
; LV-NEXT:    br label %[[LOOP:.*]]
; LV:       [[LOOP]]:
; LV-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; LV-NEXT:    [[GEP:%.*]] = getelementptr inbounds i16, ptr [[DST]], i64 [[IV]]
; LV-NEXT:    [[GEP_C:%.*]] = call ptr @llvm.mem.claim.p0(ptr [[GEP]], i64 2, i64 0)
; LV-NEXT:    store i16 [[G16]], ptr [[GEP_C]], align 2
; LV-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], [[G64]]
; LV-NEXT:    [[CMP:%.*]] = icmp ult i64 [[IV_NEXT]], 16
; LV-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT]], !llvm.loop [[LOOP15:![0-9]+]]
; LV:       [[EXIT]]:
; LV-NEXT:    ret void
;
; SLP-LABEL: define void @zext_stride(
; SLP-SAME: i1 [[G:%.*]], ptr [[DST:%.*]]) #[[ATTR2:[0-9]+]] {
; SLP-NEXT:  [[ENTRY:.*]]:
; SLP-NEXT:    [[G16:%.*]] = zext i1 [[G]] to i16
; SLP-NEXT:    [[G64:%.*]] = zext i1 [[G]] to i64
; SLP-NEXT:    br label %[[LOOP:.*]]
; SLP:       [[LOOP]]:
; SLP-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; SLP-NEXT:    [[GEP:%.*]] = getelementptr inbounds i16, ptr [[DST]], i64 [[IV]]
; SLP-NEXT:    [[GEP_C:%.*]] = call ptr @llvm.mem.claim.p0(ptr [[GEP]], i64 2, i64 0)
; SLP-NEXT:    store i16 [[G16]], ptr [[GEP_C]], align 2
; SLP-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], [[G64]]
; SLP-NEXT:    [[CMP:%.*]] = icmp ult i64 [[IV_NEXT]], 16
; SLP-NEXT:    br i1 [[CMP]], label %[[LOOP]], label %[[EXIT:.*]]
; SLP:       [[EXIT]]:
; SLP-NEXT:    ret void
