; SLP-LABEL: define void @slp(
; SLP-SAME: ptr [[A:%.*]], ptr [[B:%.*]]) {
; SLP-NEXT:    call void @llvm.mem.fact() [ "mem.claim"(ptr [[A]], i64 8, i64 0) ]
; SLP-NEXT:    call void @llvm.mem.fact() [ "mem.invalidate"(ptr [[A]], i64 0) ]
; SLP-NEXT:    [[TMP1:%.*]] = load <2 x i32>, ptr [[A]], align 4
; SLP-NEXT:    [[TMP2:%.*]] = add <2 x i32> [[TMP1]], splat (i32 7)
