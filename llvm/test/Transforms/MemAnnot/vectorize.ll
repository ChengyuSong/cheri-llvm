; LV-NEXT:    [[TMP11:%.*]] = load i64, ptr [[TMP7]], align 8, !llvm.access.group [[ACC_GRP10]]
; LV-NEXT:    [[TMP12:%.*]] = getelementptr inbounds i32, ptr [[A]], i64 [[TMP8]]
