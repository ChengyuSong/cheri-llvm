; LV-NEXT:    [[X0:%.*]] = load i32, ptr [[A]], align 4
; LV-NEXT:    call void @llvm.mem.fact() [ "mem.claim"(ptr [[A]], i64 8, i64 0) ]
; LV-NEXT:    [[X1:%.*]] = load i32, ptr [[A1]], align 4
; LV-NEXT:    [[Y0:%.*]] = add i32 [[X0]], 7
; LV-NEXT:    [[Y1:%.*]] = add i32 [[X1]], 7
; LV-NEXT:    store i32 [[Y0]], ptr [[B]], align 4
; LV-NEXT:    call void @llvm.mem.fact() [ "mem.invalidate"(ptr [[A]], i64 0) ]
; LV-NEXT:    store i32 [[Y1]], ptr [[B1]], align 4
