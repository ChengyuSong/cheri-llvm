  %b1 = getelementptr inbounds i32, ptr %b, i64 1
  %x0 = load i32, ptr %a
  call void @llvm.mem.fact() [ "mem.claim"(ptr %a, i64 8, i64 0) ]
  %x1 = load i32, ptr %a1
