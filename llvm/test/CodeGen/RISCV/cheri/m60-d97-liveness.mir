# [LLM-generated] M6.1 D97/D98. A pseudo whose register is read again is
# dropped. A dead register is cleared. A stack-colored address that is
# later the input of csetbounds keeps the loan pseudo dropped. C1 nulls that
# callee-saved cap after the csetbounds, once it is dead before the return.
# A spill slot that is
# reloaded after the clear is not nulled. A bounded cap that is live
# around a loop is cleared on the exit edge, not inside the loop.
# RUN: llc -mtriple=riscv64 -target-abi l64pc128d -mattr=+m,+a,+f,+d,+c,+xcheri,+xcheripurecap -verify-machineinstrs -run-pass=riscv-cheri-cap-invalidate -cheri-invalidate-stats-out=%t.stats -o - %s | FileCheck %s
# RUN: FileCheck %s --check-prefix=STATS < %t.stats

--- |
  target datalayout = "e-m:e-p:64:64-pf200:128:128:128:64-i64:64-i128:128-n32:64-S128-A200-P200-G200"
  target triple = "riscv64"

  define void @live_reg() addrspace(200) { ret void }
  define void @dead_reg() addrspace(200) { ret void }
  define void @colored() addrspace(200) { ret void }
  define void @compare() addrspace(200) { ret void }
  define void @spill_later() addrspace(200) { ret void }
  define void @bounded_exit() addrspace(200) { ret void }
...
---
name:            live_reg
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    PseudoCheriCapInvalidate $x10_y, 0
    $x11_y = COPY $x10_y
    PseudoCRET implicit $x11_y

# CHECK-LABEL: name: live_reg
# CHECK: $x11_y = COPY $x10_y
# CHECK-NOT: PseudoCheriCapClear
# CHECK-NOT: CSC_128 $x0_y
---
name:            dead_reg
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    PseudoCheriCapInvalidate $x10_y, 0
    PseudoCRET

# CHECK-LABEL: name: dead_reg
# CHECK: $x10_y = PseudoCheriCapClear $x10_y
# CHECK-NEXT: PseudoCRET
---
name:            colored
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    $x8_y = CIncOffsetImm %stack.0, 0
    PseudoCheriCapInvalidate $x8_y, 0
    $x10_y = CSetBoundsImm $x8_y, 48
    PseudoCRET implicit $x10_y

stack:
  - { id: 0, name: '', type: default, offset: 0, size: 48, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }

# CHECK-LABEL: name: colored
# CHECK: $x8_y = CIncOffsetImm %stack.0, 0
# CHECK-NEXT: $x10_y = CSetBoundsImm $x8_y, 48
# CHECK-NEXT: $x8_y = PseudoCheriCapClear killed $x8_y
---
name:            compare
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x8_y
    PseudoCheriCapInvalidate $x8_y, 0
    $x11 = PseudoCGetAddr $x8_y
    PseudoBR %bb.1

  bb.1:
    liveins: $x11
    PseudoCRET implicit $x11

# The freed capability is still read by an address compare. Do not null it.
# CHECK-LABEL: name: compare
# CHECK: $x11 = PseudoCGetAddr $x8_y
# CHECK-NOT: PseudoCheriCapClear
---
name:            spill_later
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    $x10_y = CLC_128 %stack.0, 0
    PseudoCheriCapInvalidate $x10_y, 0
    $x11_y = CLC_128 %stack.0, 0
    PseudoCRET implicit $x11_y

stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 16, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }

# CHECK-LABEL: name: spill_later
# CHECK: $x10_y = CLC_128 %stack.0, 0
# CHECK-NEXT: $x10_y = PseudoCheriCapClear $x10_y
# CHECK-NEXT: $x11_y = CLC_128 %stack.0, 0
# CHECK-NOT: CSC_128 $x0_y
---
name:            bounded_exit
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    $x11_y = CIncOffsetImm %stack.0, 0
    $x10_y = CSetBoundsImm $x11_y, 8
    PseudoBR %bb.1

  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x10_y, $x11_y
    $x12_y = COPY $x10_y
    PseudoCheriCapInvalidate $x11_y, 1
    BNE $x0, $x0, %bb.1
    PseudoBR %bb.2

  bb.2:
    PseudoCRET

stack:
  - { id: 0, name: '', type: default, offset: 0, size: 8, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }

# CHECK-LABEL: name: bounded_exit
# CHECK: $x10_y = CSetBoundsImm $x11_y, 8
# CHECK: bb.1:
# CHECK: $x12_y = COPY $x10_y
# CHECK-NOT: PseudoCheriCapClear $x10_y
# CHECK: $x11_y = PseudoCheriCapClear $x11_y
# CHECK-NOT: PseudoCheriCapClear $x10_y
# CHECK: bb.2:
# The bounded cap dies only on the exit edge. D100 does not split it.
# STATS: aborts=0
# STATS: nulls=0
# STATS: capreg_skipped_live=3
# STATS: capreg_skipped_edge=1
