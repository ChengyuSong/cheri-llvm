# [LLM-generated] M7.1c-2c-narrow. Default mayfree plants a C1 clear only when
# the dead capability is still in the register or spill slot across a call
# tagged riscv-cheri-mayfree (mem.free or a moved-owner call) before the
# return. all keeps a clear before any call or return. off plants nothing.
# RUN: llc -mtriple=riscv64 -target-abi l64pc128d -mattr=+m,+a,+f,+d,+c,+xcheri,+xcheripurecap -verify-machineinstrs -run-pass=riscv-cheri-cap-invalidate -cheri-invalidate-stats-out=%t.stats -o - %s | FileCheck %s
# RUN: FileCheck %s --check-prefix=STATS < %t.stats
# RUN: llc -mtriple=riscv64 -target-abi l64pc128d -mattr=+m,+a,+f,+d,+c,+xcheri,+xcheripurecap -verify-machineinstrs -run-pass=riscv-cheri-cap-invalidate -cheri-invalidate-dead-csr=all -o - %s | FileCheck %s --check-prefix=ALL
# RUN: llc -mtriple=riscv64 -target-abi l64pc128d -mattr=+m,+a,+f,+d,+c,+xcheri,+xcheripurecap -verify-machineinstrs -run-pass=riscv-cheri-cap-invalidate -cheri-invalidate-dead-csr=off -o - %s | FileCheck %s --check-prefix=OFF

--- |
  target datalayout = "e-m:e-p:64:64-pf200:128:128:128:64-i64:64-i128:128-n32:64-S128-A200-P200-G200"
  target triple = "riscv64"

  define void @csr_drop() addrspace(200) { ret void }
  define void @csr_plain() addrspace(200) { ret void }
  define void @csr_ret() addrspace(200) { ret void }
  define void @spill_drop() addrspace(200) { ret void }
  define void @spill_plain() addrspace(200) { ret void }
  define void @csr_used_after() addrspace(200) { ret void }
  define void @csr_loop() addrspace(200) { ret void }
  declare void @later() addrspace(200)
...
---
name:            csr_drop
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    $x9_y = COPY $x10_y
    $x11_y = COPY $x9_y
    PseudoCCALL target-flags(riscv-call, riscv-cheri-mayfree) @later, csr_il32pc64d_l64pc128d, implicit-def dead $x1_y, implicit-def $x2_y
    PseudoCRET

# Dead s1 across a may-free call.
# CHECK-LABEL: name: csr_drop
# CHECK: $x11_y = COPY $x9_y
# CHECK-NEXT: $x9_y = PseudoCheriCapClear killed $x9_y
# CHECK-NEXT: PseudoCCALL
# ALL-LABEL: name: csr_drop
# ALL: $x11_y = COPY $x9_y
# ALL-NEXT: $x9_y = PseudoCheriCapClear killed $x9_y
# ALL-NEXT: PseudoCCALL
# OFF-LABEL: name: csr_drop
# OFF: $x11_y = COPY $x9_y
# OFF-NEXT: PseudoCCALL
# OFF-NOT: PseudoCheriCapClear
---
name:            csr_plain
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    $x9_y = COPY $x10_y
    $x11_y = COPY $x9_y
    PseudoCCALL target-flags(riscv-call) @later, csr_il32pc64d_l64pc128d, implicit-def dead $x1_y, implicit-def $x2_y
    PseudoCRET

# No may-free call. mayfree leaves s1 for the epilogue restore. all clears it.
# CHECK-LABEL: name: csr_plain
# CHECK: $x11_y = COPY $x9_y
# CHECK-NEXT: PseudoCCALL
# CHECK-NOT: PseudoCheriCapClear
# ALL-LABEL: name: csr_plain
# ALL: $x11_y = COPY $x9_y
# ALL-NEXT: $x9_y = PseudoCheriCapClear killed $x9_y
# ALL-NEXT: PseudoCCALL
# OFF-LABEL: name: csr_plain
# OFF: $x11_y = COPY $x9_y
# OFF-NEXT: PseudoCCALL
# OFF-NOT: PseudoCheriCapClear
---
name:            csr_ret
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    $x9_y = COPY $x10_y
    $x11_y = COPY $x9_y
    PseudoCRET

# Dead before the return, with no call. mayfree skips it. all clears it.
# CHECK-LABEL: name: csr_ret
# CHECK: $x11_y = COPY $x9_y
# CHECK-NEXT: PseudoCRET
# CHECK-NOT: PseudoCheriCapClear
# ALL-LABEL: name: csr_ret
# ALL: $x11_y = COPY $x9_y
# ALL-NEXT: $x9_y = PseudoCheriCapClear killed $x9_y
# ALL-NEXT: PseudoCRET
# OFF-LABEL: name: csr_ret
# OFF: $x11_y = COPY $x9_y
# OFF-NEXT: PseudoCRET
# OFF-NOT: PseudoCheriCapClear
---
name:            spill_drop
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    $x10_y = CLC_128 %stack.0, 0
    PseudoCCALL target-flags(riscv-call, riscv-cheri-mayfree) @later, csr_il32pc64d_l64pc128d, implicit-def dead $x1_y, implicit-def $x2_y
    PseudoCRET

stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 16, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }

# Last reload, then a moved-owner call. The null address is the frame index.
# CHECK-LABEL: name: spill_drop
# CHECK: $x10_y = CLC_128 %stack.0, 0
# CHECK-NEXT: CSC_128 $x0_y, %stack.0, 0
# CHECK-NEXT: PseudoCCALL
# CHECK-NOT: CSC_128 $x0_y, $x
# ALL-LABEL: name: spill_drop
# ALL: $x10_y = CLC_128 %stack.0, 0
# ALL-NEXT: CSC_128 $x0_y, %stack.0, 0
# ALL-NEXT: PseudoCCALL
# OFF-LABEL: name: spill_drop
# OFF: $x10_y = CLC_128 %stack.0, 0
# OFF-NEXT: PseudoCCALL
# OFF-NOT: CSC_128 $x0_y
---
name:            spill_plain
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    $x10_y = CLC_128 %stack.0, 0
    PseudoCCALL target-flags(riscv-call) @later, csr_il32pc64d_l64pc128d, implicit-def dead $x1_y, implicit-def $x2_y
    PseudoCRET

stack:
  - { id: 0, name: '', type: spill-slot, offset: 0, size: 16, alignment: 16,
      stack-id: default, callee-saved-register: '', callee-saved-restored: true,
      debug-info-variable: '', debug-info-expression: '', debug-info-location: '' }

# A spill that only crosses an ordinary call is left for the frame wipe.
# CHECK-LABEL: name: spill_plain
# CHECK: $x10_y = CLC_128 %stack.0, 0
# CHECK-NEXT: PseudoCCALL
# CHECK-NOT: CSC_128 $x0_y
# ALL-LABEL: name: spill_plain
# ALL: $x10_y = CLC_128 %stack.0, 0
# ALL-NEXT: CSC_128 $x0_y, %stack.0, 0
# ALL-NEXT: PseudoCCALL
---
name:            csr_used_after
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    liveins: $x10_y
    $x9_y = COPY $x10_y
    PseudoCCALL target-flags(riscv-call, riscv-cheri-mayfree) @later, csr_il32pc64d_l64pc128d, implicit-def dead $x1_y, implicit-def $x2_y
    $x11_y = COPY $x9_y
    PseudoCRET

# s1 is read after the may-free call, so that call does not get a clear.
# CHECK-LABEL: name: csr_used_after
# CHECK: $x9_y = COPY $x10_y
# CHECK-NEXT: PseudoCCALL
# CHECK-NEXT: $x11_y = COPY $x9_y
# CHECK-NEXT: PseudoCRET
# CHECK-NOT: PseudoCheriCapClear
# ALL-LABEL: name: csr_used_after
# ALL: $x9_y = COPY $x10_y
# ALL-NEXT: PseudoCCALL
# ALL-NEXT: $x11_y = COPY $x9_y
# ALL-NEXT: $x9_y = PseudoCheriCapClear killed $x9_y
# ALL-NEXT: PseudoCRET
---
name:            csr_loop
alignment:       2
tracksRegLiveness: true
noVRegs:         true
isSSA:           false
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $x10_y
    $x9_y = COPY $x10_y
    PseudoBR %bb.1

  bb.1:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $x9_y
    $x11_y = COPY $x9_y
    PseudoCCALL target-flags(riscv-call, riscv-cheri-mayfree) @later, csr_il32pc64d_l64pc128d, implicit-def dead $x1_y, implicit-def $x2_y
    BNE $x0, $x0, %bb.1
    PseudoBR %bb.2

  bb.2:
    liveins: $x9_y
    PseudoCRET implicit $x9_y

# The back edge still reads s1.
# CHECK-LABEL: name: csr_loop
# CHECK: $x11_y = COPY $x9_y
# CHECK-NOT: PseudoCheriCapClear
# ALL-LABEL: name: csr_loop
# ALL: $x11_y = COPY $x9_y
# ALL-NOT: PseudoCheriCapClear
# STATS: cheri-dead-cap: fn=csr_drop csr=1 spill=0 skip_csr=0 skip_spill=0
# STATS: cheri-dead-cap: fn=csr_plain csr=0 spill=0 skip_csr=1 skip_spill=0
# STATS: cheri-dead-cap: fn=csr_ret csr=0 spill=0 skip_csr=1 skip_spill=0
# STATS: cheri-dead-cap: fn=spill_drop csr=0 spill=1 skip_csr=0 skip_spill=0
# STATS: cheri-dead-cap: fn=spill_plain csr=0 spill=0 skip_csr=0 skip_spill=1
# STATS: cheri-dead-cap: fn=csr_used_after csr=0 spill=0 skip_csr=1 skip_spill=0
# STATS: cheri-dead-cap: csr=1 spill=1 skip_csr=3 skip_spill=1
