# CHECK-NOT: BLTU
# CHECK: PseudoCBR %bb.2
# CHECK-LABEL: bb.1:
# CHECK: UNIMP
# CHECK-LABEL: bb.2:
# CHECK: CLB

# CHECK-LABEL: name: match_4095
