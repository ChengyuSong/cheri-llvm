    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 31
    BLTU %lim, %idx, %bb.2
    PseudoCBR %bb.1

