# [LLM-generated] M6.2 D110. One pre-RA block: CSetBoundsImm of a constant
# length in 1..4095, an unsigned compare of an index against that length,
# and a branch to a panic block with no other predecessor. The index is
# used only as the offset of a CIncOffset of that capability, and that
# pointer is only loaded or stored.
#
# RUN: llc -mtriple=riscv64 -target-abi l64pc128d -mattr=+m,+a,+f,+d,+c,+xcheri,+xcheripurecap -run-pass=riscv-cheri-hw-subsume -verify-machineinstrs -o - %s | FileCheck %s

---
name: match_fallthrough
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10_y, $x11
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 31
    BLTU %lim, %idx, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
    %v:gpr = CLB %p, 0
    $x10 = COPY %v
    PseudoCRET implicit $x10

  bb.2:
    UNIMP
...
---
name: match_gep_store
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10_y, $x11, $x12
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %val:gpr = COPY $x12
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 32
    BGEU %idx, %lim, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
    CSB %val, %p, 0
    PseudoCRET

  bb.2:
    UNIMP
...
---
name: match_taken_ok
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10_y, $x11
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 32
    BLTU %idx, %lim, %bb.2
    PseudoCBR %bb.1

  bb.1:
    UNIMP

  bb.2:
    %p:ygpr = CIncOffset %cap, %idx
    %v:gpr = CLB %p, 0
    $x10 = COPY %v
    PseudoCRET implicit $x10
...
---
name: match_4095
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10_y, $x11
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %cap:ygpr = CSetBoundsImm %base, 4095
    %hi:gpr = LUI 1
    %lim:gpr = ADDI %hi, -2
    BLTU %lim, %idx, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
    %v:gpr = CLB %p, 0
    $x10 = COPY %v
    PseudoCRET implicit $x10

  bb.2:
    UNIMP
...
---
name: match_nested_gep
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10_y, $x11
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 31
    BLTU %lim, %idx, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
    %q:ygpr = CIncOffsetImm %p, 4
    %v:gpr = CLB %q, 0
    $x10 = COPY %v
    PseudoCRET implicit $x10

  bb.2:
    UNIMP
...
---
name: keep_rounded
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
