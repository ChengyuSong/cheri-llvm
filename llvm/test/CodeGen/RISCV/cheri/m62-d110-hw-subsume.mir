    liveins: $x10_y, $x11
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %n:gpr = LUI 1
    %cap:ygpr = CSetBounds %base, %n
    %lim:gpr = LUI 1
    BGEU %idx, %lim, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
