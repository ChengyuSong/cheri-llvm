name: keep_gep_stored
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10_y, $x11, $x12_y
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %slot:ygpr = COPY $x12_y
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 31
    BLTU %lim, %idx, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
    CSC_128 %p, %slot, 0
    PseudoCRET

  bb.2:
    UNIMP
...
