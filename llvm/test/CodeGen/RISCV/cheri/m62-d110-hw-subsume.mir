...

# CHECK-LABEL: name: match_fallthrough
# CHECK: CSetBoundsImm
# CHECK-NOT: BLTU
# CHECK-NOT: BGEU
# CHECK-NOT: PseudoCBR
# CHECK: CIncOffset
# CHECK: CLB
# CHECK-LABEL: bb.2:
# CHECK: UNIMP

# CHECK-LABEL: name: match_gep_store
# CHECK: CSetBoundsImm
# CHECK-NOT: BGEU
# CHECK-NOT: BLTU
# CHECK: CIncOffset
# CHECK: CSB

# CHECK-LABEL: name: match_taken_ok
