    liveins: $x10_y, $x11, $x12
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %n:gpr = COPY $x12
    %cap:ygpr = CSetBoundsExact %base, %n
    %lim:gpr = ADDI $x0, 32
    BGEU %idx, %lim, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
