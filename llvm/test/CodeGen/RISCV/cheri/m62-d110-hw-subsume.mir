---
name: keep_shared_panic
isSSA: true
tracksRegLiveness: false
noVRegs: false
body: |
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $x10_y, $x11, $x12
    %idx:gpr = COPY $x11
    %idx2:gpr = COPY $x12
    %base:ygpr = COPY $x10_y
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 31
    BLTU %lim, %idx, %bb.3
    PseudoCBR %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    %p:ygpr = CIncOffset %cap, %idx
    %v:gpr = CLB %p, 0
    %cap2:ygpr = CSetBoundsImm %base, 16
    %lim2:gpr = ADDI $x0, 15
    BLTU %lim2, %idx2, %bb.3
    PseudoCBR %bb.2

  bb.2:
    %q:ygpr = CIncOffset %cap2, %idx2
    %w:gpr = CLB %q, 0
    $x10 = COPY %w
    PseudoCRET implicit $x10

  bb.3:
    UNIMP
...
---
