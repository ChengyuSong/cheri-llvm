    successors: %bb.1, %bb.2
    liveins: $x10_y, $x11
    %idx:gpr = COPY $x11
    %base:ygpr = COPY $x10_y
    %cap:ygpr = CSetBoundsImm %base, 32
    %lim:gpr = ADDI $x0, 31
    BLTU %lim, %idx, %bb.2
    PseudoCBR %bb.1

  bb.1:
    %p:ygpr = CIncOffset %cap, %idx
    %v:gpr = CLB %p, 0
    %s:gpr = ADD %idx, %idx
    $x10 = COPY %s
    PseudoCRET implicit $x10

  bb.2:
    UNIMP
...
